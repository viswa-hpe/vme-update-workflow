resource "file-content" "91f966f4-f905-46b5-b66d-d737f96852dc" {
  uuid = "91f966f4-f905-46b5-b66d-d737f96852dc"
  content = <<EOFSCRIBE
#!/bin/bash
 
JSON_FILE="/tmp/cluster-info.json"
IP_LIST=$(jq -r '.node[0] | to_entries[] | .value.ip_address' "$JSON_FILE")
 
myVal=$IP_LIST
echo "$(date '+%Y-%m-%d %H:%M:%S') List of nodes available for update: $myVal"
 
token=<%=morpheus.getApiAccessToken()%>
applianceHost=<%=morpheus.applianceHost%>
applianceUrl=<%=morpheus.applianceUrl%>
 
fetch_task_id() {
  local manager_ip="$1"
  local name_query_param="$2"
  local bearer_token="$3"
 
  json_out=$(curl --request GET \
          --url "https://${manager_ip}/api/tasks?max=25&offset=0&sort=name&direction=asc&name=${name_query_param}" \
          --header 'accept: application/json' \
          --header "authorization: Bearer $bearer_token" -k -vv 2>/dev/null)
 
  task_id=$(echo $json_out | jq  '.tasks[0].id')
  echo $task_id
  return 0
}
 
 
wait_for_job_completion() {
  local host="$1"
  local job_id="$2"
  local retry_count="$3"
  local retry_interval="$4"
 
  i=0
  job_status="running" # Initial status for the loop to start
  while [ "$i" -le "$retry_count" ] && [ "$job_status" == "running" ]
  do
    sleep $retry_interval
     echo "$(date '+%Y-%m-%d %H:%M:%S') Wait for job completion on $host status is: $job_status"
     i=$((i + 1))
          job_status=$(curl --request GET   --url https://${applianceHost}/api/job-executions/${job_id}  \
          --header 'accept: application/json'     \
          --header "authorization: Bearer ${token}" \
          --header 'content-type: application/json'\
          -k  -vv 2> /dev/null | jq -r ' .jobExecution.process.status')
  done
}
 
host_os_update_task_id=$(fetch_task_id ${applianceHost} Update-HVM-host $token)
echo "$(date '+%Y-%m-%d %H:%M:%S') TaskID for node update: $host_os_update_task_id"
host_spp_update_task_id=$(fetch_task_id ${applianceHost} Update-NodeSPP-DryRun $token)
echo "$(date '+%Y-%m-%d %H:%M:%S') TaskID for SPP firmware upgrade (DRY-RUN) $host_spp_update_task_id"
 
###################################################################################
#  update node OS
###################################################################################
for val in $myVal
do
echo "$(date '+%Y-%m-%d %H:%M:%S') Updating HPE VME Node : $val"
 
job_id=$(curl --request POST \
     --url https://${applianceHost}/api/tasks/${host_os_update_task_id}/execute \
     --header 'accept: application/json' \
     --header "authorization: Bearer ${token}" \
     --header 'content-type: application/json' \
     --data '
{
  "job": {
    "customOptions": {
      "hostIP": '$val'
    }
  }
}
' -k -vv  2>/dev/null | jq -r '.job.id')
 
job_status=$(wait_for_job_completion $val ${job_id} 40 120)
 
 
echo "$(date '+%Y-%m-%d %H:%M:%S') Update HPE VME Node $val status is: $job_status"
###################################################################################
#  update node SSP (DRY-RUN)
###################################################################################
echo "$(date '+%Y-%m-%d %H:%M:%S') Updating(dry-run) SPP firmware for the node: $val"
job_id=$(curl --request POST \
     --url https://${applianceHost}/api/tasks/${host_spp_update_task_id}/execute \
     --header 'accept: application/json' \
     --header "authorization: Bearer ${token}" \
     --header 'content-type: application/json' \
     --data '
{  "job": {
    "customOptions": {
      "hostIP": '$val'
    }
  }
}
' -k -vv  2>/dev/null | jq -r '.job.id')
 
job_status=$(wait_for_job_completion $val ${job_id} 40 120)
 
echo "$(date '+%Y-%m-%d %H:%M:%S') Update(dry-run) SPP firmware for the node $val status is: $job_status"
 
done
exit 0
EOFSCRIBE
  dateCreated = "2025-06-24T11:34:50.000Z"
  lastUpdated = "2025-06-25T14:39:28.000Z"
}