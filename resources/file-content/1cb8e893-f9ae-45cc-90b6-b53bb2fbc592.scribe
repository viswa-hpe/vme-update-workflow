resource "file-content" "1cb8e893-f9ae-45cc-90b6-b53bb2fbc592" {
  uuid = "1cb8e893-f9ae-45cc-90b6-b53bb2fbc592"
  content = <<EOFSCRIBE
#!/bin/bash

# === Configuration ===
array_ip="172.30.1.174"
POLL_INTERVAL=5
TIMEOUT=3600

session_token=""
recommendation_uri=""
task_uri=""

# === Functions ===
get_session_token() {
  response=$(curl -s -k -X POST "https://$array_ip/api/v3/credentials" \
  -H "Content-Type:application/json" \
  -d '{"user":"3paradm","password":"3pardata"}')

  session_token=$(echo "$response" | jq -r '.key')
  if [ -z "$session_token" ]; then
    echo "[ERROR] Failed to fetch session token."
    exit 1
  fi
  echo "[INFO] Session token obtained."
}

poll_task() {
  elapsed=0
  while [ "$elapsed" -lt "$TIMEOUT" ]; do
    response=$(curl -s -k -X GET "https://${array_ip}$1" \
    -H "Authorization: Bearer $session_token" \
    -H "accept: application/json" \
    -H "Content-Type:application/json")

    echo "[DEBUG] Task response: $response"
    if ! echo "$response" | jq empty >/dev/null 2>&1; then
      echo "[ERROR] Invalid JSON received."
      exit 3
    fi

    status=$(echo "$response" | jq -r '.status')
    if [ -z "$status" ]; then
        echo "[WARN] Task status not found"
        exit 3
    fi

    case "$status" in
      "STATE_FINISHED") echo "[DEBUG] Task succeeded."; break ;;
      "STATE_RUNNING") echo "[DEBUG] $2 task is running..." ;;
      *) echo "[ERROR] $2 task status: $status"; exit 3 ;;
    esac

    sleep "$POLL_INTERVAL"
    elapsed=$((elapsed + POLL_INTERVAL))
  done
}

fetch_recommendations() {
  response=$(curl -s -k -X GET "https://$array_ip/api/v3/softwareupdate/recommendations" \
    -H "accept: application/json" \
    -H "Content-Type:application/json" \
    -H "Authorization: Bearer $session_token")

  echo "[DEBUG] Recommendations response: $response"

  if ! echo "$response" | jq empty >/dev/null 2>&1; then
   echo "[ERROR] Invalid JSON received for recommendations."
   exit 3
  fi

  recommendation_uri=$(echo "$response" | jq -r '.members | to_entries | .[0].value.uri // empty')
  echo "[DEBUG] Recommendations URI: $recommendation_uri"
  if [ -z "$recommendation_uri" ]; then
    echo "[ERROR] No recommendations found for software update."
    exit 1
  fi
}

perform_action() {
  response=$(curl -s -k -X POST "https://$array_ip$1" \
    -H "accept: application/json" \
    -H "Authorization: Bearer $session_token" \
    -H "content-type: application/json" \
    -d "$2")

  echo "[DEBUG] Task response: $response for action: $3."
  if ! echo "$response" | jq empty >/dev/null 2>&1; then
    echo "[ERROR] Invalid JSON received while performing action $3."
    exit 3
  fi

  task_uri=$(echo "$response" | jq -r '.taskUri')
  if [ -z "$task_uri" ] || [ "$task_uri" == "null" ]; then
    default_message=$(echo "$response" | jq -r '.message.default // empty')
    echo "[ERROR] Couldn't fetch task uri for action: $3 due to: $default_message"
    exit 3
  fi

  echo "[DEBUG] Retrieved task URI: $task_uri for action: $3."
}

# === Main ===
echo "[INFO] Upgrading array os..."
# 1. Fetch session token
get_session_token

# 2. Fetch recommendations
fetch_recommendations

# 3. Perform READINESS_CHECK action for the recommendation
echo "recommendation_uri: $recommendation_uri"
perform_action "$recommendation_uri" "{\"action\":\"READINESS_CHECK\"}" "READINESS_CHECK"

# 4. Poll the readiness task until it finishes
echo "[DEBUG] READINESS_CHECK action task uri: $task_uri"
poll_task "$task_uri" "READINESS_CHECK"

# 5. Perform UPDATE action for the recommendation
perform_action "$recommendation_uri" "{\"action\":\"UPDATE\",\"parameters\":{\"preupgradewarn\":\"true\"}}" "UPDATE"

# 6. Poll the update task until it finishes
echo "[DEBUG] UPDATE action task uri: $task_uri"
poll_task "$task_uri" "UPDATE"

echo "[INFO] Update process completed successfully on array: $array_ip"
EOFSCRIBE
  dateCreated = "2025-06-24T11:20:57.000Z"
  lastUpdated = "2025-07-04T07:09:03.000Z"
}