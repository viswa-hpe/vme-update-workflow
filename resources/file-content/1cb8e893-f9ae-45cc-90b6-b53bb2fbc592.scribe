resource "file-content" "1cb8e893-f9ae-45cc-90b6-b53bb2fbc592" {
  uuid = "1cb8e893-f9ae-45cc-90b6-b53bb2fbc592"
  content = <<EOFSCRIBE
#!/bin/bash
#
# © Copyright 2025 Hewlett Packard Enterprise Development LP
#
# Array OS Update Script
# This script checks for and applies software updates to the storage array.
# It performs a readiness check before updating and monitors task progress.

# Ensure script runs as root
[ "$EUID" -ne 0 ] && exec sudo "$0" "$@"

# === Configuration ===
ARRAY_IP="172.30.1.174"
POLL_INTERVAL=5
TIMEOUT=5400
EXIT_CODE_AUTH_ERROR=1
EXIT_CODE_TASK_ERROR=3

# === Global Variables ===
session_token=""
recommendation_uri=""
task_uri=""

# === Functions ===
# Unified logging function with timestamp and log level
log() {
    local level="$1"
    local message="$2"
    local timestamp=$(date +'%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $message"

    # Exit on error with provided code or default
    if [ "$level" = "ERROR" ]; then
        exit "${3:-$EXIT_CODE_TASK_ERROR}"
    fi
}

# Get authentication token from the array
get_session_token() {
    local pollToken="$1"
    log "INFO" "Authenticating with array at $ARRAY_IP..."

    for _ in {1..20}; do
        session_token=$(curl -s -k -X POST "https://$ARRAY_IP/api/v3/credentials" \
            -H "Content-Type: application/json" \
            -d '{"user":"3paradm","password":"3pardata"}' --noproxy '*' | jq -r '.key // empty')

        if [ -n "$session_token" ]; then
            log "INFO" "Session token obtained successfully"
            break
        fi

        if [ -n "$pollToken" ]; then
            log "INFO" "Array temporarily unavailable. Retrying in 30 seconds..."
            sleep 30
        fi
    done

    [ -z "$session_token" ] && log "ERROR" "Failed to fetch session token" "$EXIT_CODE_AUTH_ERROR"
}

# Poll a task until completion or timeout
poll_task() {
    local task_uri="$1"
    local task_name="$2"
    local elapsed=0

    log "INFO" "Monitoring $task_name task progress..."

    while [ "$elapsed" -lt "$TIMEOUT" ]; do
        response=$(curl -s -k -X GET "https://${ARRAY_IP}$task_uri" \
            -H "Authorization: Bearer $session_token" \
            -H "Content-Type: application/json" \
            -H "Accept: application/json" --noproxy '*')

        #log "DEBUG" "Task response: $response"

        if [ -z "$response" ]; then
            log "INFO" "No response received while polling the task: $task_uri. The array may be temporarily unreachable. Waiting for 5 minutes before retrying."
            sleep 300
            elapsed=$((elapsed + 300))
            get_session_token "POLL_TOKEN"
            continue
        fi

        status=$(echo "$response" | jq -r '.status // empty')

        case "$status" in
            "STATE_FINISHED")
                log "INFO" "$task_name task completed successfully"
                return 0
                ;;
            "STATE_RUNNING")
                # Only log running status occasionally to reduce noise
                [ $((elapsed % 30)) -eq 0 ] && log "INFO" "$task_name task is running..."
                ;;
            *)
                log "ERROR" "$task_name task failed with status: $status" "$EXIT_CODE_TASK_ERROR"
                ;;
        esac

        sleep "$POLL_INTERVAL"
        elapsed=$((elapsed + POLL_INTERVAL))
    done

    log "ERROR" "$task_name task timed out after $TIMEOUT seconds" "$EXIT_CODE_TASK_ERROR"
}

# Fetch software update recommendations from the array
fetch_recommendations() {
    log "INFO" "Checking for software update recommendations..."

    recommendation_uri=$(curl -s -k -X GET "https://$ARRAY_IP/api/v3/softwareupdate/recommendations" \
        -H "Accept: application/json" \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $session_token" --noproxy '*' | \
        jq -r '.members | to_entries | .[0].value.uri // empty')

    [ -z "$recommendation_uri" ] && { log "WARN" "No recommendations found. Array software is up to date."; exit 0; }
    log "INFO" "Found software update recommendation. URI: $recommendation_uri"
}

# Perform an action on the array
perform_action() {
    local uri="$1"
    local payload="$2"
    local action_name="$3"

    log "INFO" "Initiating $action_name action..."

    response=$(curl -s -k -X POST "https://$ARRAY_IP$uri" \
        -H "Accept: application/json" \
        -H "Authorization: Bearer $session_token" \
        -H "Content-Type: application/json" \
        -d "$payload" --noproxy '*')

    task_uri=$(echo "$response" | jq -r '.taskUri // empty')

    [ -z "$task_uri" ] && log "ERROR" "Unable to start $action_name. Action may already be in progress." "$EXIT_CODE_TASK_ERROR"
    log "INFO" "$action_name action initiated successfully"
}

# Main function to orchestrate the update process
main() {
    log "INFO" "Starting array OS update process for $ARRAY_IP"

    # Authentication
    get_session_token

    # Check for updates
    fetch_recommendations

    # Perform readiness check
    perform_action "$recommendation_uri" '{"action":"READINESS_CHECK"}' "READINESS_CHECK"
    poll_task "$task_uri" "READINESS_CHECK"

    # Uncomment below lines to perform the actual update
    log "INFO" "Proceeding with software update..."
    perform_action "$recommendation_uri" '{"action":"UPDATE","parameters":{"preupgradewarn":"true"}}' "UPDATE"
    poll_task "$task_uri" "UPDATE"

    log "INFO" "Array OS update process completed successfully"
}

# Execute main function
main
EOFSCRIBE
  dateCreated = "2025-06-24T11:20:57.000Z"
  lastUpdated = "2025-06-27T19:06:52.000Z"
}